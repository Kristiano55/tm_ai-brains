{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tm_ai brain pack entry (packs/<pack_id>.json, as submitted)",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "kind", "author", "author_github", "created", "code_version", "input_fingerprint",
               "lineage", "maps", "sha256", "size", "asset_url", "status"],
  "properties": {
    "pack_id": {"type": "string", "pattern": "^[a-z0-9-]{1,20}-[0-9a-f]{8}$"},
    "kind": {"enum": ["map", "base"]},
    "author": {"type": "string", "maxLength": 40},
    "author_github": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"},
    "created": {"type": "integer", "minimum": 1700000000},
    "code_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}$"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "base_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{12}$"},
    "lineage": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[0-9a-f]{12}$"}},
    "steps": {"type": ["integer", "null"], "minimum": 0},
    "note": {"type": "string", "maxLength": 500},
    "maps": {"type": "array", "minItems": 1, "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false, "required": ["uid"],
      "properties": {
        "uid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{5,40}$"},
        "name": {"type": ["string", "null"], "maxLength": 120},
        "champion_ms": {"type": ["integer", "null"], "minimum": 1},
        "best_ms": {"type": ["integer", "null"], "minimum": 1},
        "pb_ms": {"type": ["integer", "null"], "minimum": 1},
        "wr_ms": {"type": ["integer", "null"], "minimum": 1}}}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 1, "maximum": 209715200},
    "asset_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+/releases/download/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\\.tmbrain\\.zip$"},
    "status": {"const": "unverified"}
  }
}
